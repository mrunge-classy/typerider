#!/usr/bin/env node
'use strict';

/* Command line for the Typerider leaderboard API.
   Zero dependencies, like the rest of the project: global fetch and
   node:util.parseArgs. The admin password is never a command-line argument —
   see resolvePassword() for where it comes from. */

const { parseArgs } = require('node:util');
const { spawnSync } = require('node:child_process');
const fs = require('node:fs');
const os = require('node:os');
const path = require('node:path');
const readline = require('node:readline/promises');

// Nothing points at a particular deployment any more. A fresh install knows no
// host at all and says which key to set; the two zugriff.at addresses that used
// to live here are now just entries in one person's config file.
const CONFIG_DIR = process.env.TYPERIDER_CONFIG_DIR ||
  path.join(os.homedir(), '.config', 'typerider-leaderboard');
const CONFIG_FILE = path.join(CONFIG_DIR, 'config.json');

// ---------------------------------------------------------------------- args

let opts, positionals;
try {
  ({ values: opts, positionals } = parseArgs({
    allowPositionals: true,
    options: {
      json: { type: 'boolean', default: false },
      yes: { type: 'boolean', short: 'y', default: false },
      'admin-url': { type: 'string' },
      'public-url': { type: 'string' },
      'password-file': { type: 'string' },
      'no-color': { type: 'boolean', default: false },
      help: { type: 'boolean', short: 'h', default: false }
    }
  }));
} catch (err) {
  process.stderr.write(`error: ${err.message}\nTry \`typerider-leaderboard --help\`.\n`);
  process.exit(1);
}

const ESC = '\u001b';
const COLOR = process.stdout.isTTY && !opts['no-color'] && !process.env.NO_COLOR;
const c = (code, s) => (COLOR ? `${ESC}[${code}m${s}${ESC}[0m` : String(s));
const bold = (s) => c('1', s);
const dim = (s) => c('2', s);
const red = (s) => c('31', s);
const green = (s) => c('32', s);

// -------------------------------------------------------------------- config

const CONFIG_KEYS = {
  'admin.url': 'host serving /api/admin -- the admin vhost, or your single host',
  'public.url': 'host visitors play on (default: same as admin.url)',
  'admin.user': 'basic-auth username (default: admin)',
  'admin.password-file': 'path to the admin password, plain or .gpg'
};

function readConfig() {
  let raw;
  try {
    raw = fs.readFileSync(CONFIG_FILE, 'utf8');
  } catch (err) {
    if (err.code === 'ENOENT') return {};
    throw err;
  }
  let parsed;
  try {
    parsed = JSON.parse(raw);
  } catch (err) {
    fail(`${CONFIG_FILE} is not valid JSON: ${err.message}`);
  }
  if (!parsed || typeof parsed !== 'object' || Array.isArray(parsed)) {
    fail(`${CONFIG_FILE} does not hold a JSON object.`);
  }
  return parsed;
}

function writeConfig(cfg) {
  fs.mkdirSync(CONFIG_DIR, { recursive: true, mode: 0o700 });
  // 600: admin.password-file records where a credential lives, and the host list
  // alone is worth not leaving readable on a shared box.
  fs.writeFileSync(CONFIG_FILE, JSON.stringify(cfg, null, 2) + '\n', { mode: 0o600 });
}

const config = readConfig();
const trimSlash = (s) => String(s).replace(/\/$/, '');

// Flag, then environment, then config file. Nothing after that -- a missing host
// is an error naming the key to set, not a silent fallback to somebody else's.
const adminUrl = trimSlash(
  opts['admin-url'] || process.env.TYPERIDER_ADMIN_URL || config['admin.url'] || '');
// public.url stays optional: on a single-host deployment it IS admin.url, and
// that is the shape someone running this for the first time has.
const publicUrl = trimSlash(
  opts['public-url'] || process.env.TYPERIDER_PUBLIC_URL || config['public.url'] || adminUrl);

function requireUrl(url, key) {
  if (url) return url;
  fail(`no ${key} configured. Point this at your typerider:\n` +
       `       typerider-leaderboard config set ${key} https://your-host`);
}

const USAGE = `typerider-leaderboard — administer the Typerider leaderboard

  board                    the live board: every entry with its id (default)
  top [n]                  the public leaderboard, as visitors see it
  rm <entry-id | name>     remove one rider (kept in the deleted log)
  reset                    retire the board and start a fresh one
  limit [n]                show, or set, how many rows the homepage shows (3-50)
  deleted                  riders removed from a board, newest first
  archives                 boards that have been retired
  archive <board-id>       one retired board in full
  check                    reachability and access control; writes nothing
  config [list|get|set|unset]   the host this talks to, and how it authenticates

Options
  --json                   print the raw API response
  -y, --yes                skip the confirmation prompt on rm and reset
  --admin-url <url>        override admin.url for this run
  --public-url <url>       override public.url for this run
  --password-file <path>   read the admin password from this file
  --no-color               plain output
  -h, --help               this

First run, against your own typerider:

  typerider-leaderboard config set admin.url https://your-host
  typerider-leaderboard check

Settings live in ${CONFIG_FILE}:

${Object.entries(CONFIG_KEYS).map(([k, d]) => `  ${k.padEnd(21)}${d}`).join('\n')}

Set public.url only if visitors use a different host from the admin one, as they
do behind a split-vhost proxy. The admin password is looked up, in order:
--password-file, $TYPERIDER_ADMIN_PASSWORD, the admin.password-file key,
then admin.pw.gpg or admin.pw in the config directory (gpg prompts for the
passphrase itself). With none of those the tool sends no credential, which is
what you want against a server that is not asking for one:

  typerider-leaderboard board --admin-url http://127.0.0.1:3034`;

// -------------------------------------------------------------------- output

function fail(message) {
  process.stderr.write(red('error: ') + message + '\n');
  process.exit(1);
}

// --------------------------------------------------------------- credentials

let cachedPassword;

function readPasswordFile(file) {
  const stat = fs.statSync(file);
  // A plaintext credential group- or world-readable is a mistake worth stopping for.
  if (!file.endsWith('.gpg') && (stat.mode & 0o077) !== 0) {
    fail(`${file} is readable by others — chmod 600 it, or encrypt it with gpg -c.`);
  }
  if (!file.endsWith('.gpg')) return fs.readFileSync(file, 'utf8').trim();

  // gpg owns the passphrase prompt: stdin and stderr stay attached to the
  // terminal so pinentry works and gpg-agent can cache it. The passphrase
  // never passes through this process.
  //
  // pinentry needs to know which terminal to draw on. Interactive shells set
  // GPG_TTY from their rc file; nothing guarantees it here, so derive it.
  const env = { ...process.env };
  if (!env.GPG_TTY && process.stdin.isTTY) {
    try { env.GPG_TTY = fs.readlinkSync('/proc/self/fd/0'); } catch { /* not Linux */ }
  }

  const out = spawnSync('gpg', ['--quiet', '--decrypt', file], {
    stdio: ['inherit', 'pipe', 'inherit'],
    encoding: 'utf8',
    env
  });
  if (out.error) fail(`could not run gpg: ${out.error.message}`);
  if (out.status !== 0) fail(`gpg could not decrypt ${file}`);
  return out.stdout.trim();
}

function resolvePassword() {
  if (cachedPassword !== undefined) return cachedPassword;

  const explicit = opts['password-file'];
  if (explicit) {
    if (!fs.existsSync(explicit)) fail(`no such password file: ${explicit}`);
    return (cachedPassword = readPasswordFile(explicit));
  }
  if (process.env.TYPERIDER_ADMIN_PASSWORD) {
    return (cachedPassword = process.env.TYPERIDER_ADMIN_PASSWORD);
  }
  const configured = config['admin.password-file'];
  if (configured) {
    const file = configured.replace(/^~(?=\/|$)/, os.homedir());
    if (!fs.existsSync(file)) fail(`admin.password-file points at a missing file: ${file}`);
    return (cachedPassword = readPasswordFile(file));
  }
  // Unconfigured but conventional: the files this tool has always looked for.
  for (const name of ['admin.pw.gpg', 'admin.pw']) {
    const file = path.join(CONFIG_DIR, name);
    if (fs.existsSync(file)) return (cachedPassword = readPasswordFile(file));
  }
  return (cachedPassword = null);
}

function authHeader() {
  const pw = resolvePassword();
  if (!pw) return null;
  // The app checks the password only, but nginx's htpasswd checks both halves,
  // so whoever set that up needs to be able to say which name it expects.
  const user = config['admin.user'] || 'admin';
  return 'Basic ' + Buffer.from(`${user}:${pw}`).toString('base64');
}

// ----------------------------------------------------------------------- api

let warnedNoCredential = false;

async function api(route, { method = 'GET', body, auth = true, base = adminUrl } = {}) {
  requireUrl(base, base === publicUrl && base !== adminUrl ? 'public.url' : 'admin.url');
  const headers = {};
  if (body !== undefined) headers['Content-Type'] = 'application/json';

  if (auth) {
    const header = authHeader();
    if (header) {
      headers.Authorization = header;
    } else if (!warnedNoCredential) {
      warnedNoCredential = true;
      process.stderr.write(dim('note: no admin password found, sending unauthenticated\n'));
    }
  }

  let res;
  try {
    res = await fetch(base + route, {
      method,
      headers,
      body: body === undefined ? undefined : JSON.stringify(body)
    });
  } catch (err) {
    fail(`${base} is unreachable: ${err.message}`);
  }

  const text = await res.text();
  let data = null;
  try { data = JSON.parse(text); } catch { /* nginx errors come back as HTML */ }

  if (!res.ok) {
    if (res.status === 401) {
      fail('401 — the admin password was rejected. Check admin.password-file and\n' +
           '       admin.user in `typerider-leaderboard config list`, or pass --password-file.');
    }
    // A 404 with no JSON body is nginx, not the app: almost always the admin
    // API being asked for on the public host, where it is blocked by design.
    if (res.status === 404 && !data && route.startsWith('/api/admin')) {
      fail(`404 from ${base}${route}\n` +
           '       Behind a split-vhost proxy the admin API is blocked on the public\n' +
           '       host by design. Check that admin.url names the admin host.');
    }
    fail(`${res.status} ${res.statusText}${data && data.error ? ` — ${data.error}` : ''}`);
  }
  return data;
}

// ------------------------------------------------------------------ printing

function when(ms, withTime = true) {
  if (!ms) return '—';
  return new Date(ms).toLocaleString('en-GB', {
    day: 'numeric', month: 'short', year: 'numeric',
    ...(withTime ? { hour: '2-digit', minute: '2-digit' } : {})
  });
}

// Column widths must ignore the escape sequences colour adds.
const width = (s) => String(s ?? '').replace(new RegExp(`${ESC}\\[[0-9;]*m`, 'g'), '').length;

function table(headers, rows, numeric = []) {
  if (!rows.length) return '';
  const widths = headers.map((h, i) =>
    Math.max(width(h), ...rows.map((r) => width(r[i]))));
  const line = (cells) => cells
    .map((cell, i) => {
      const pad = ' '.repeat(widths[i] - width(cell));
      return numeric.includes(i) ? pad + cell : cell + pad;
    })
    .join('  ')
    .trimEnd();
  return [dim(line(headers)), ...rows.map((r) => line(r.map((x) => String(x ?? ''))))].join('\n');
}

function out(data, render) {
  if (opts.json) {
    process.stdout.write(JSON.stringify(data, null, 2) + '\n');
    return;
  }
  render();
}

async function confirm(question, expect) {
  if (opts.yes) return true;
  if (!process.stdin.isTTY) {
    fail('refusing to do that without a confirmation. Re-run with --yes if you mean it.');
  }
  const rl = readline.createInterface({ input: process.stdin, output: process.stdout });
  const answer = (await rl.question(question)).trim();
  rl.close();
  return expect === undefined ? /^y(es)?$/i.test(answer) : answer === expect;
}

// ------------------------------------------------------------------ commands

async function cmdBoard() {
  const data = await api('/api/admin/board');
  out(data, () => {
    process.stdout.write(
      `${bold('Board')} ${data.board.id}\n` +
      dim(`started ${when(data.board.createdAt)} · ${data.players} rider(s) · ` +
          `top ${data.settings.leaderboardLimit} shown on the homepage`) + '\n\n');
    if (!data.entries.length) {
      process.stdout.write(dim('The board is empty.') + '\n');
      return;
    }
    process.stdout.write(table(
      ['#', 'RIDER', 'STORY', 'ACC', 'WPM', 'PLAYED', 'ENTRY ID'],
      data.entries.map((e) => [
        e.rank, e.name, e.track || '—',
        `${Number(e.accuracy).toFixed(0)}%`, Number(e.wpm).toFixed(1),
        when(e.playedAt), dim(e.id)
      ]),
      [0, 3, 4]) + '\n');
  });
}

async function cmdTop(n) {
  const q = n === undefined ? '' : `?limit=${encodeURIComponent(n)}`;
  const data = await api('/api/leaderboard' + q, { auth: false, base: publicUrl });
  out(data, () => {
    process.stdout.write(dim(`Board started ${when(data.board.createdAt, false)} · ` +
      `${data.players} rider(s) · showing up to ${data.limit}`) + '\n\n');
    if (!data.entries.length) {
      process.stdout.write(dim('No times yet.') + '\n');
      return;
    }
    process.stdout.write(table(
      ['#', 'RIDER', 'STORY', 'ACC', 'WPM'],
      data.entries.map((e) => [
        e.rank, e.name, e.track || '—',
        `${Number(e.accuracy).toFixed(0)}%`, Number(e.wpm).toFixed(1)
      ]),
      [0, 3, 4]) + '\n');
  });
}

async function cmdRm(needle) {
  if (!needle) {
    fail('which rider? Pass an entry id or a name — `typerider-leaderboard board` lists both.');
  }

  const board = await api('/api/admin/board');
  const target = board.entries.find((e) => e.id === needle) ||
    board.entries.find((e) => e.name.toLowerCase() === needle.toLowerCase());
  if (!target) fail(`no rider on the live board matching "${needle}".`);

  const ok = await confirm(
    `Remove ${bold(target.name)} (${Number(target.wpm).toFixed(1)} WPM)? ` +
    dim('Kept in the deleted log.') + ' [y/N] ');
  if (!ok) {
    process.stderr.write('Left alone.\n');
    return;
  }

  const data = await api(`/api/admin/entry?id=${encodeURIComponent(target.id)}`, { method: 'DELETE' });
  out(data, () => process.stdout.write(
    `${green('Removed')} ${data.deleted.name} — ${data.players} rider(s) left on the board.\n`));
}

async function cmdReset() {
  const board = await api('/api/admin/board');
  const ok = await confirm(
    `This retires the board started ${when(board.board.createdAt)} with ` +
    `${board.players} rider(s). It is archived, not deleted.\n` +
    `Type the board id to confirm (${dim(board.board.id)}): `,
    board.board.id);
  if (!ok) {
    process.stderr.write('That did not match. Board left alone.\n');
    return;
  }

  const data = await api('/api/admin/reset', { method: 'POST' });
  out(data, () => process.stdout.write(
    (data.archived
      ? `${green('Archived')} ${data.archivedEntries} rider(s) to ${data.archived}\n`
      : `${green('Reset')} — the board was empty, so nothing was archived.\n`) +
    (data.pruned ? dim(`Pruned ${data.pruned} archive(s) beyond the 50 kept.\n`) : '') +
    `New board ${data.board.id}, started ${when(data.board.createdAt)}.\n`));
}

async function cmdLimit(n) {
  if (n === undefined) {
    const data = await api('/api/admin/board');
    out(data.settings, () => process.stdout.write(
      `The homepage shows up to ${bold(data.settings.leaderboardLimit)} rows.\n`));
    return;
  }
  const value = Number(n);
  if (!Number.isInteger(value)) fail(`"${n}" is not a whole number.`);

  const data = await api('/api/admin/settings', { method: 'POST', body: { leaderboardLimit: value } });
  out(data, () => process.stdout.write(
    `${green('Set')} — the homepage now shows up to ${data.settings.leaderboardLimit} rows.\n`));
}

async function cmdDeleted() {
  const data = await api('/api/admin/board');
  out(data.deleted, () => {
    if (!data.deleted.length) {
      process.stdout.write(dim('Nothing has been removed from a board yet.') + '\n');
      return;
    }
    const rows = data.deleted
      .slice()
      .sort((a, b) => b.deletedAt - a.deletedAt)
      .map((d) => [
        d.entry.name, Number(d.entry.wpm).toFixed(1),
        when(d.deletedAt), dim(d.boardId), when(d.boardCreatedAt, false)
      ]);
    process.stdout.write(
      table(['RIDER', 'WPM', 'REMOVED', 'FROM BOARD', 'BOARD STARTED'], rows, [1]) + '\n');
  });
}

async function cmdArchives() {
  const data = await api('/api/admin/board');
  out(data.archives, () => {
    if (!data.archives.length) {
      process.stdout.write(dim('No board has been reset yet.') + '\n');
      return;
    }
    process.stdout.write(table(
      ['STARTED', 'RIDERS', 'BOARD ID', 'FILE'],
      data.archives.map((a) => [when(a.createdAt), a.entries, dim(a.id), dim(a.file)]),
      [1]) + '\n');
  });
}

async function cmdArchive(id) {
  if (!id) fail('which board? `typerider-leaderboard archives` lists the ids.');
  const { board } = await api(`/api/admin/archive?id=${encodeURIComponent(id)}`);
  out(board, () => {
    process.stdout.write(
      `${bold('Archived board')} ${board.id}\n` +
      dim(`started ${when(board.createdAt)} · ${board.entries.length} rider(s)`) + '\n\n');
    if (!board.entries.length) {
      process.stdout.write(dim('It was empty when it was retired.') + '\n');
      return;
    }
    const ranked = board.entries
      .slice()
      .sort((a, b) => b.wpm - a.wpm || b.accuracy - a.accuracy || a.playedAt - b.playedAt);
    process.stdout.write(table(
      ['#', 'RIDER', 'STORY', 'ACC', 'WPM', 'PLAYED'],
      ranked.map((e, i) => [
        i + 1, e.name, e.track || '—',
        `${Number(e.accuracy).toFixed(0)}%`, Number(e.wpm).toFixed(1), when(e.playedAt)
      ]),
      [0, 3, 4]) + '\n');
  });
}

async function cmdConfig(action = 'list', key, value) {
  if (action === 'list') {
    out(config, () => {
      // Key and value only. A long password path would otherwise stretch the
      // column and push the descriptions off the right of the terminal; --help
      // is where they are explained.
      const rows = Object.keys(CONFIG_KEYS).map((k) =>
        [k, config[k] === undefined ? dim('(unset)') : config[k]]);
      process.stdout.write(dim(CONFIG_FILE) + '\n\n' + table(['KEY', 'VALUE'], rows) +
        '\n\n' + dim('`--help` says what each key is for.') + '\n');
    });
    return;
  }
  if (!['get', 'set', 'unset'].includes(action)) {
    fail(`config takes list, get, set or unset — not "${action}".`);
  }
  if (!Object.prototype.hasOwnProperty.call(CONFIG_KEYS, key)) {
    fail(`unknown key ${key ? `"${key}"` : ''}. Known keys:\n` +
      Object.entries(CONFIG_KEYS).map(([k, d]) => `       ${k.padEnd(21)}${d}`).join('\n'));
  }

  if (action === 'get') {
    if (config[key] === undefined) fail(`${key} is not set.`);
    process.stdout.write(config[key] + '\n');
    return;
  }
  if (action === 'unset') {
    if (config[key] === undefined) fail(`${key} is not set.`);
    delete config[key];
    writeConfig(config);
    process.stdout.write(`${green('Unset')} ${key}\n`);
    return;
  }
  if (value === undefined) fail(`config set ${key} needs a value.`);

  if (key.endsWith('.url')) {
    // Catch a pasted URL that carries a path or a query now, with the mistake
    // still in view. Stored unchecked it breaks every route at once, and the
    // resulting 404s look like a server fault rather than a typo.
    let parsed;
    try { parsed = new URL(value); } catch { fail(`"${value}" is not a URL.`); }
    if (!/^https?:$/.test(parsed.protocol)) fail(`${key} must be http or https.`);
    if (parsed.pathname !== '/' || parsed.search || parsed.hash) {
      fail(`${key} takes a host, without a path — try ${parsed.origin}`);
    }
    value = parsed.origin;
  }

  config[key] = value;
  writeConfig(config);
  process.stdout.write(`${green('Set')} ${key} = ${value}\n` + dim(CONFIG_FILE) + '\n');
}

// Reads only. The point is not that the server answers but that the admin
// surface is shut to anyone without the password -- a regression there is
// silent until someone goes looking.
//
// Two deployment shapes, told apart by whether the two hosts differ rather than
// by a setting: on a split-vhost proxy the public host must not expose
// /api/admin at all and the admin host must demand a password; on one host the
// same property reduces to the admin API refusing an unauthenticated caller.
async function cmdCheck() {
  const header = authHeader();
  const withAuth = header ? { headers: { Authorization: header } } : {};

  const probe = async (label, url, init, expected) => {
    try {
      const status = (await fetch(url, init)).status;
      return { label, url, status, expected, ok: expected.includes(status) };
    } catch (err) {
      return { label, url, status: null, expected, ok: false, detail: err.message };
    }
  };

  requireUrl(adminUrl, 'admin.url');
  const splitHost = publicUrl !== adminUrl;

  const results = [
    await probe('public homepage', `${publicUrl}/`, {}, [200]),
    await probe('public leaderboard API', `${publicUrl}/api/leaderboard`, {}, [200]),

    ...(splitHost
      ? [
        await probe('admin API blocked on public host', `${publicUrl}/api/admin/board`, {}, [404]),
        await probe('admin page demands a password', `${adminUrl}/`, {}, [401])
      ]
      // 403 counts: an app with no ADMIN_PASSWORD set refuses a caller that did
      // not arrive through something local, which shuts the surface just as well.
      : [
        await probe('admin API refuses anonymous callers',
          `${adminUrl}/api/admin/board`, {}, [401, 403, 404]),
        await probe('admin page refuses anonymous callers',
          `${adminUrl}/admin`, {}, [401, 403, 404])
      ]),

    await probe('admin page with password', `${adminUrl}${splitHost ? '/' : '/admin'}`, withAuth, [200]),
    await probe('admin API with password', `${adminUrl}/api/admin/board`, withAuth, [200])
  ];

  out(results, () => {
    for (const r of results) {
      const mark = r.ok ? green('ok  ') : red('FAIL');
      const got = r.status === null ? r.detail : r.status;
      const want = r.ok ? '' : dim(` (expected ${r.expected.join(' or ')})`);
      process.stdout.write(`${mark} ${String(got).padEnd(5)} ${r.label}${want}\n`);
    }
  });
  if (!results.every((r) => r.ok)) process.exit(1);
}

// ------------------------------------------------------------------ dispatch

async function main() {
  if (opts.help) {
    process.stdout.write(USAGE + '\n');
    return;
  }
  const [command = 'board', arg, arg2, arg3] = positionals;

  switch (command) {
    case 'board': case 'entries': return cmdBoard();
    case 'top': return cmdTop(arg);
    case 'rm': case 'remove': case 'delete': return cmdRm(arg);
    case 'reset': return cmdReset();
    case 'limit': return cmdLimit(arg);
    case 'deleted': return cmdDeleted();
    case 'archives': return cmdArchives();
    case 'archive': return cmdArchive(arg);
    case 'check': return cmdCheck();
    case 'config': return cmdConfig(arg, arg2, arg3);
    case 'help': process.stdout.write(USAGE + '\n'); return;
    default: fail(`unknown command "${command}".\n\n${USAGE}`);
  }
}

main().catch((err) => fail(err.stack || err.message));
